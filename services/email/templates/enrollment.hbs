<!DOCTYPE html>
<html>
<head><meta charset="utf-8"><title>Enrollment Confirmation</title></head>
<body style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; padding: 20px;">
  <div style="background: #4F46E5; color: white; padding: 20px; text-align: center; border-radius: 8px 8px 0 0;">
    <h1 style="margin: 0;">Enrollment Confirmed!</h1>
  </div>
  <div style="background: #f9fafb; padding: 30px; border: 1px solid #e5e7eb;">
    <p>Hi {{name}},</p>
    <p>You've been successfully enrolled in <strong>{{courseName}}</strong>.</p>
    <div style="background: white; padding: 20px; border-radius: 8px; margin: 20px 0;">
      <h3 style="margin-top:0;">Course Details</h3>
      <p><strong>Course:</strong> {{courseName}}</p>
      <p><strong>Instructor:</strong> {{instructor}}</p>
      <p><strong>Duration:</strong> {{duration}}</p>
      <p><strong>Enrolled:</strong> {{enrolledAt}}</p>
    </div>
    <div style="text-align: center; margin: 30px 0;">
      <a href="{{clientUrl}}/my-courses" style="background: #4F46E5; color: white; padding: 12px 24px; text-decoration: none; border-radius: 6px;">Start Learning</a>
    </div>
    <p>Best,<br>The KKIT Team</p>
  </div>
</body>
</html>
