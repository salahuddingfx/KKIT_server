NODE_ENV=development
PORT=5000
DB_HOST=localhost
DB_PORT=3306
DB_NAME=kkit_db
DB_USER=root
DB_PASS=your_password
DB_DIALECT=mysql

JWT_SECRET=your_jwt_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=7d

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
SMTP_API_KEY=
FROM_EMAIL=your_email@gmail.com
FROM_NAME=KKIT

# Video Streaming Engine (Bunny Stream)
BUNNY_STREAM_LIBRARY_ID=your_bunny_library_id
BUNNY_STREAM_API_KEY=your_bunny_api_key
BUNNY_STREAM_TOKEN_KEY=your_bunny_token_security_key

STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASS=your_store_password
SSLCOMMERZ_IS_LIVE=false

BKASH_APP_KEY=your_bkash_app_key
BKASH_APP_SECRET=your_bkash_app_secret
BKASH_USERNAME=your_bkash_username
BKASH_PASSWORD=your_bkash_password

CLIENT_URL=http://localhost:4000
ADMIN_URL=http://localhost:4001

# SMS Gateway Configuration
# Supported providers: bulksmsbd, greenweb, alphasms, twilio, generic
SMS_ENABLED=true
SMS_PROVIDER=bulksmsbd
SMS_API_KEY=your_sms_api_key_here
SMS_SENDER_ID=KKIT
SMS_API_URL=
SMS_USERNAME=
SMS_PASSWORD=

# Google Analytics 4 (GA4) Tracking Configuration
# Client-side: NEXT_PUBLIC_GA4_ID
# Server-side Measurement Protocol: GA4_MEASUREMENT_ID & GA4_API_SECRET
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_API_SECRET=your_ga4_api_secret_here
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX

